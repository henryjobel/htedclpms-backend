generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ========================
// USER & AUTH
// ========================

model User {
  id        String    @id @default(cuid()) @map("_id")
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      Role      @relation(fields: [roleId], references: [id])
  roleId    String
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vouchers  Voucher[]
  tasks     Task[]
  createdBillingRecords BillingRecord[]
  approvalLogs ApprovalLog[]
}

model Role {
  id          String       @id @default(cuid()) @map("_id")
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id     String @id @default(cuid()) @map("_id")
  module String
  action String
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String
}

// ========================
// PROJECT MODULE
// ========================

model Project {
  id          String        @id @default(cuid()) @map("_id")
  name        String
  location    String
  type        String
  status      ProjectStatus @default(PLANNING)
  budget      Float         @default(0)
  startDate   DateTime
  endDate     DateTime
  manager     String
  totalUnits  Int           @default(0)
  soldUnits   Int           @default(0)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  boqItems           BOQItem[]
  tasks              Task[]
  progressLogs       ProgressLog[]
  requisitions       MaterialRequisition[]
  projectExpenses    ProjectExpense[]
  installments       Installment[]
  contractorAssigns  ContractorAssignment[]
  workerAssigns      WorkerAssignment[]
  bills              Bill[]
  quotations         Quotation[]
  workOrders         WorkOrder[]
  billingRecords     BillingRecord[]
  assets             AssetItem[]
  vouchers           Voucher[]
  purchaseOrders     PurchaseOrder[]
  ledgerEntries      LedgerEntry[]
  rfqs               RFQ[]
  propertyBlocks     PropertyBlock[]
  propertyRoads      PropertyRoad[]
  propertyUnits      PropertyUnit[]
  propertyBookings   PropertyBooking[]
  propertySales      PropertySale[]
  investments        ProjectInvestment[]
  shareAssigns       ShareAssignment[]
  shareConfigs       ShareProjectConfig[]
  documents          ProjectDocument[]
  sites              ProjectSite[]
  ganttTasks         GanttTask[]
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model BOQItem {
  id           String   @id @default(cuid()) @map("_id")
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  description  String
  unit         String
  quantity     Float
  unitRate     Float
  materialCost Float    @default(0)
  laborCost    Float    @default(0)
  totalCost    Float
  phase        String?
  createdAt    DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid()) @map("_id")
  project     Project    @relation(fields: [projectId], references: [id])
  projectId   String
  title       String
  description String?
  assignedTo  User       @relation(fields: [userId], references: [id])
  userId      String
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  progress    Int        @default(0)
  dueDate     DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProgressLog {
  id         String   @id @default(cuid()) @map("_id")
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  phase      String
  percentage Float
  remarks    String?
  logDate    DateTime @default(now())
  createdAt  DateTime @default(now())
}

// ========================
// CONTRACTOR & WORKER
// ========================

model Contractor {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  specialty   String
  phone       String?
  email       String?
  address     String?
  nidNumber   String?
  bankAccount String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ContractorAssignment[]
  bills       Bill[]
  workOrders  WorkOrder[]
  billingRecords BillingRecord[]
}

model ContractorAssignment {
  id            String     @id @default(cuid()) @map("_id")
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  contractorId  String
  project       Project    @relation(fields: [projectId], references: [id])
  projectId     String
  contractValue Float
  paid          Float      @default(0)
  startDate     DateTime
  endDate       DateTime?
  status        String     @default("active")
  createdAt     DateTime   @default(now())
}

model Worker {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  role        String
  phone       String?
  nidNumber   String?
  dailyWage   Float
  bankAccount String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments WorkerAssignment[]
  billingRecords BillingRecord[]
}

model WorkerAssignment {
  id         String   @id @default(cuid()) @map("_id")
  worker     Worker   @relation(fields: [workerId], references: [id])
  workerId   String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  month      DateTime
  daysWorked Int      @default(0)
  totalWage  Float    @default(0)
  paid       Float    @default(0)
  createdAt  DateTime @default(now())
}

// ========================
// REAL ESTATE / FLAT-LAND
// ========================

model PropertyBlock {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  code      String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units PropertyUnit[]

  @@unique([projectId, name])
}

model PropertyRoad {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  code      String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units PropertyUnit[]

  @@unique([projectId, name])
}

model PropertyUnit {
  id           String            @id @default(cuid()) @map("_id")
  unitNo       String
  type         PropertyUnitType
  size         Float?
  sizeUnit     String?
  facing       String?
  price        Float             @default(0)
  status       PropertyUnitStatus @default(AVAILABLE)
  description  String?
  project      Project           @relation(fields: [projectId], references: [id])
  projectId    String
  block        PropertyBlock?    @relation(fields: [blockId], references: [id])
  blockId      String?
  road         PropertyRoad?     @relation(fields: [roadId], references: [id])
  roadId       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  bookings PropertyBooking[]
  sales    PropertySale[]

  @@unique([projectId, unitNo])
}

enum PropertyUnitType {
  FLAT
  LAND
  SHOP
  OFFICE
}

enum PropertyUnitStatus {
  AVAILABLE
  BOOKED
  SOLD
  HOLD
}

model PropertyBooking {
  id            String               @id @default(cuid()) @map("_id")
  bookingNo     String               @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  bookingDate   DateTime             @default(now())
  bookingAmount Float                @default(0)
  status        PropertyBookingStatus @default(ACTIVE)
  remarks       String?
  project       Project              @relation(fields: [projectId], references: [id])
  projectId     String
  unit          PropertyUnit         @relation(fields: [unitId], references: [id])
  unitId        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  sale PropertySale?
}

enum PropertyBookingStatus {
  ACTIVE
  CANCELLED
  CONVERTED
}

model PropertySale {
  id            String           @id @default(cuid()) @map("_id")
  saleNo        String           @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  saleDate      DateTime         @default(now())
  saleAmount    Float
  paidAmount    Float            @default(0)
  dueAmount     Float            @default(0)
  status        PropertySaleStatus @default(PARTIAL)
  remarks       String?
  project       Project          @relation(fields: [projectId], references: [id])
  projectId     String
  unit          PropertyUnit     @relation(fields: [unitId], references: [id])
  unitId        String
  booking       PropertyBooking? @relation(fields: [bookingId], references: [id])
  bookingId     String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum PropertySaleStatus {
  PAID
  PARTIAL
  DUE
  CANCELLED
}

// ========================
// INVENTORY MODULE
// ========================

model Product {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  category      String
  unit          String
  stock         Float    @default(0)
  minStock      Float    @default(0)
  purchasePrice Float    @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  stockAdjustments  StockAdjustment[]
  requisitionItems  RequisitionItem[]
  purchaseItems     PurchaseOrderItem[]
  grnItems          GRNItem[]
}

model Supplier {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  taxId     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  rfqs           RFQ[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]
}

model StockAdjustment {
  id         String   @id @default(cuid()) @map("_id")
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  type       String
  quantity   Float
  reason     String?
  adjustedBy String
  createdAt  DateTime @default(now())
}

// ========================
// PROCUREMENT MODULE
// ========================

model MaterialRequisition {
  id           String            @id @default(cuid()) @map("_id")
  project      Project           @relation(fields: [projectId], references: [id])
  projectId    String
  requestedBy  String
  status       RequisitionStatus @default(PENDING)
  requiredDate DateTime
  priority     Priority          @default(MEDIUM)
  remarks      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items RequisitionItem[]
}

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model RequisitionItem {
  id            String              @id @default(cuid()) @map("_id")
  requisition   MaterialRequisition @relation(fields: [requisitionId], references: [id])
  requisitionId String
  product       Product             @relation(fields: [productId], references: [id])
  productId     String
  quantity      Float
  unit          String
}

model RFQ {
  id         String    @id @default(cuid()) @map("_id")
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  supplierId String
  project    Project?  @relation(fields: [projectId], references: [id])
  projectId  String?
  status     RFQStatus @default(PENDING)
  quotedAmount Float?
  deliveryDays Int?
  paymentTerms String?
  comparisonNotes String?
  isSelected Boolean @default(false)
  sentDate   DateTime  @default(now())
  deadline   DateTime?
  remarks    String?
  createdAt  DateTime  @default(now())

  purchaseOrders PurchaseOrder[]
}

enum RFQStatus {
  PENDING
  SENT
  RECEIVED
  APPROVED
  REJECTED
}

model PurchaseOrder {
  id           String    @id @default(cuid()) @map("_id")
  poNumber     String    @unique
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  supplierId   String
  project      Project?  @relation(fields: [projectId], references: [id])
  projectId    String?
  rfq          RFQ?      @relation(fields: [rfqId], references: [id])
  rfqId        String?
  status       POStatus  @default(DRAFT)
  totalAmount  Float     @default(0)
  deliveryDate DateTime?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items PurchaseOrderItem[]
  grns  GRN[]
  bills Bill[]
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id          String        @id @default(cuid()) @map("_id")
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  poId        String
  product     Product       @relation(fields: [productId], references: [id])
  productId   String
  quantity    Float
  unit        String
  unitRate    Float
  totalAmount Float
}

model GRN {
  id           String        @id @default(cuid()) @map("_id")
  grnNumber    String        @unique
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  poId         String
  receivedDate DateTime      @default(now())
  receivedBy   String
  status       String        @default("complete")
  remarks      String?
  createdAt    DateTime      @default(now())

  items GRNItem[]
}

model GRNItem {
  id          String  @id @default(cuid()) @map("_id")
  grn         GRN     @relation(fields: [grnId], references: [id])
  grnId       String
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  orderedQty  Float
  receivedQty Float
  damagedQty  Float   @default(0)
  acceptedQty Float
  unit        String
}

// ========================
// ACCOUNTS MODULE
// ========================

model Account {
  id          String      @id @default(cuid()) @map("_id")
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  ledgerEntries LedgerEntry[]
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
  BANK
  CASH
}

model Voucher {
  id          String      @id @default(cuid()) @map("_id")
  voucherNo   String      @unique
  type        VoucherType
  project     Project?    @relation(fields: [projectId], references: [id])
  projectId   String?
  amount      Float
  description String?
  status      String      @default("pending")
  createdBy   User        @relation(fields: [userId], references: [id])
  userId      String
  voucherDate DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ledgerEntries LedgerEntry[]
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  ADJUSTMENT
}

model LedgerEntry {
  id          String   @id @default(cuid()) @map("_id")
  voucher     Voucher? @relation(fields: [voucherId], references: [id])
  voucherId   String?
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  debit       Float    @default(0)
  credit      Float    @default(0)
  description String?
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model BankAccount {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  bankName  String
  accountNo String   @unique
  type      String
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BankTransaction[]
  reconciliations BankReconciliation[]
  cheques         ChequeEntry[]
}

model BankTransaction {
  id            String      @id @default(cuid()) @map("_id")
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  type          String
  amount        Float
  description   String?
  balance       Float
  transDate     DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

model Installment {
  id          String            @id @default(cuid()) @map("_id")
  client      String
  clientPhone String?
  project     Project           @relation(fields: [projectId], references: [id])
  projectId   String
  unit        String
  totalAmount Float
  paid        Float             @default(0)
  status      InstallmentStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  schedule InstallmentSchedule[]
}

enum InstallmentStatus {
  ACTIVE
  OVERDUE
  COMPLETED
}

model InstallmentSchedule {
  id            String      @id @default(cuid()) @map("_id")
  installment   Installment @relation(fields: [installmentId], references: [id])
  installmentId String
  dueDate       DateTime
  amount        Float
  paidAmount    Float       @default(0)
  paidDate      DateTime?
  status        String      @default("unpaid")
  createdAt     DateTime    @default(now())
}

model Bill {
  id           String         @id @default(cuid()) @map("_id")
  billNumber   String         @unique
  type         String
  project      Project?       @relation(fields: [projectId], references: [id])
  projectId    String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId   String?
  contractor   Contractor?    @relation(fields: [contractorId], references: [id])
  contractorId String?
  po           PurchaseOrder? @relation(fields: [poId], references: [id])
  poId         String?
  amount       Float
  dueDate      DateTime?
  status       String         @default("unpaid")
  billDate     DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProjectExpense {
  id          String   @id @default(cuid()) @map("_id")
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  category    String
  description String?
  amount      Float
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Quotation {
  id          String    @id @default(cuid()) @map("_id")
  quotationNo String    @unique
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?
  client      String?
  description String?
  amount      Float
  validUntil  DateTime?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(cuid()) @map("_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  quotationId String
  description String
  quantity    Float
  unit        String
  unitRate    Float
  totalAmount Float
}

model WorkOrder {
  id            String      @id @default(cuid()) @map("_id")
  workOrderNo   String      @unique
  title         String
  description   String?
  type          String
  status        String      @default("draft")
  amount        Float       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  vendorName    String?
  project       Project?    @relation(fields: [projectId], references: [id])
  projectId     String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  contractorId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  billingRecords BillingRecord[]
}

model BillingRecord {
  id               String              @id @default(cuid()) @map("_id")
  billingNo        String              @unique
  billingType      BillingType
  title            String
  vendorName       String?
  customerName     String?
  unitReference    String?
  quantity         Float               @default(0)
  unitRate         Float               @default(0)
  percentage       Float?
  previousAmount   Float               @default(0)
  adjustmentAmount Float               @default(0)
  retentionAmount  Float               @default(0)
  billedAmount     Float               @default(0)
  paidAmount       Float               @default(0)
  dueAmount        Float               @default(0)
  status           BillingStatus       @default(DRAFT)
  billingDate      DateTime            @default(now())
  dueDate          DateTime?
  remarks          String?
  project          Project?            @relation(fields: [projectId], references: [id])
  projectId        String?
  contractor       Contractor?         @relation(fields: [contractorId], references: [id])
  contractorId     String?
  worker           Worker?             @relation(fields: [workerId], references: [id])
  workerId         String?
  workOrder        WorkOrder?          @relation(fields: [workOrderId], references: [id])
  workOrderId      String?
  createdBy        User?               @relation(fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

enum BillingType {
  CONTRACTOR
  LABOR
  ADJUSTMENT
  PERCENTAGE
}

enum BillingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL
  PAID
  CANCELLED
}

model BankReconciliation {
  id               String                @id @default(cuid()) @map("_id")
  bankAccount      BankAccount           @relation(fields: [bankAccountId], references: [id])
  bankAccountId    String
  statementDate    DateTime
  bookBalance      Float
  statementBalance Float
  difference       Float
  notes            String?
  status           ReconciliationStatus  @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  ADJUSTED
}

model AssetItem {
  id            String      @id @default(cuid()) @map("_id")
  assetCode     String      @unique
  name          String
  category      String
  status        AssetStatus @default(ACTIVE)
  serialNo      String?
  purchaseDate  DateTime?
  purchaseValue Float       @default(0)
  currentValue  Float       @default(0)
  location      String?
  remarks       String?
  project       Project?    @relation(fields: [projectId], references: [id])
  projectId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  maintenanceLogs AssetMaintenanceLog[]
}

enum AssetStatus {
  ACTIVE
  IN_USE
  UNDER_MAINTENANCE
  DISPOSED
}

model ApprovalLayer {
  id        String   @id @default(cuid()) @map("_id")
  module    String
  level     Int
  roleName  String
  minAmount Float?
  maxAmount Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalLog {
  id         String   @id @default(cuid()) @map("_id")
  module     String
  entityType String
  entityId   String
  action     String
  status     String
  remarks    String?
  amount     Float?
  actedBy    User?    @relation(fields: [actedById], references: [id])
  actedById  String?
  createdAt  DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChequeEntry {
  id            String       @id @default(cuid()) @map("_id")
  chequeNo      String       @unique
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  type          ChequeType
  status        ChequeStatus @default(PENDING)
  payeeName     String
  amount        Float
  issueDate     DateTime     @default(now())
  chequeDate    DateTime
  clearedDate   DateTime?
  remarks       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ChequeType {
  RECEIVED
  ISSUED
}

enum ChequeStatus {
  PENDING
  DEPOSITED
  CLEARED
  BOUNCED
  CANCELLED
}

model AssetMaintenanceLog {
  id              String      @id @default(cuid()) @map("_id")
  asset           AssetItem   @relation(fields: [assetId], references: [id])
  assetId         String
  maintenanceDate DateTime    @default(now())
  description     String
  vendorName      String?
  cost            Float       @default(0)
  status          String      @default("completed")
  nextDueDate     DateTime?
  remarks         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ========================
// INVESTMENT MODULE
// ========================

model Investor {
  id           String              @id @default(cuid()) @map("_id")
  name         String
  phone        String?
  email        String?
  address      String?
  nidNumber    String?
  investorType String              @default("Individual")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  investments  ProjectInvestment[]
  shareAssigns ShareAssignment[]
}

model ProjectInvestment {
  id         String   @id @default(cuid()) @map("_id")
  investor   Investor @relation(fields: [investorId], references: [id])
  investorId String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  amount     Float    @default(0)
  percentage Float    @default(0)
  investDate DateTime @default(now())
  status     String   @default("active")
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========================
// SHARE PROJECT MODULE
// ========================

model ShareAssignment {
  id         String   @id @default(cuid()) @map("_id")
  investor   Investor @relation(fields: [investorId], references: [id])
  investorId String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  shareCount Int      @default(0)
  shareValue Float    @default(0)
  assignDate DateTime @default(now())
  status     String   @default("active")
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ShareProjectConfig {
  id          String   @id @default(cuid()) @map("_id")
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  configName  String
  totalShares Int      @default(0)
  shareValue  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================
// DOCUMENTS & SITES
// ========================

model ProjectDocument {
  id           String   @id @default(cuid()) @map("_id")
  project      Project? @relation(fields: [projectId], references: [id])
  projectId    String?
  title        String
  documentType String   @default("General")
  fileUrl      String?
  description  String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectSite {
  id          String   @id @default(cuid()) @map("_id")
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  address     String?
  area        Float?
  areaUnit    String?
  siteType    String   @default("Construction")
  status      String   @default("Active")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================
// GANTT CHART
// ========================

model GanttTask {
  id           String   @id @default(cuid()) @map("_id")
  project      Project? @relation(fields: [projectId], references: [id])
  projectId    String?
  taskName     String
  phase        String?
  startDate    DateTime
  endDate      DateTime
  progress     Float    @default(0)
  assignee     String?
  color        String?
  dependencies String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
